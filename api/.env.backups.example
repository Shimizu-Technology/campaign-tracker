# Minimum environment variables for automated database backups.
# Copy these into the Render cron service created from render.backups.yaml.
# Use placeholders only. Do not commit real credentials.

# Source database (current production stack = Render app + Neon Postgres)
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST.neon.tech/campaign_tracker_production?sslmode=require

# Backup destination
BACKUP_STORAGE_PROVIDER=s3
BACKUP_BUCKET=your-backup-bucket-name
BACKUP_PREFIX=campaign-tracker/production
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me

# Backup behavior
BACKUP_FILENAME_PREFIX=campaign-tracker
BACKUP_RETENTION_DAYS=14

# Optional alerting
BACKUP_ALERT_WEBHOOK_URL=https://example.com/webhooks/render-backup-alerts

# Notes
# - Democratic Party should get its own database and its own BACKUP_PREFIX,
#   using the same pattern instead of sharing this Campaign Tracker backup path.
# - The backup/restore shell scripts are introduced in PR #116.
