# Minimum environment variables for the backup/restore shell scripts.
# Copy only placeholders into the Render cron service created from render.backups.yaml.
# Use placeholders only. Do not commit real credentials.

# Source database for backup_postgres.sh (current production stack = Render app + Neon Postgres)
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST.neon.tech/campaign_tracker_production?sslmode=require

# Local dump behavior
# Render cron jobs only provide ephemeral filesystem space, so BACKUP_OUTPUT_DIR is for
# temporary job output unless a later step copies the dump off-host.
BACKUP_OUTPUT_DIR=/tmp/campaign-tracker-backups
BACKUP_PREFIX=campaign-tracker-production

# Restore drill only: point this at a disposable verification database, never production.
TARGET_DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST.neon.tech/campaign_tracker_restore_test?sslmode=require

# Notes
# - Democratic Party should get its own database and its own backup naming/path conventions.
# - The backup/restore shell scripts are introduced in PR #116.
# - This example does NOT include object-storage upload settings because PR #116 does not
#   upload dumps off-host yet.
